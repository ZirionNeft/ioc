{
  "name": "@zirion/ioc",
  "description": "IoC implementation using dependency injection",
  "version": "3.0.0",
  "packageManager": "yarn@4.17.1",
  "type": "module",
  "keywords": [
    "Dependency Injection",
    "IoC Container",
    "Inversion of Control",
    "IoC",
    "DI",
    "Inject",
    "Dependency",
    "DI Container",
    "Service Locator",
    "Dependency Management",
    "Object Lifecycle",
    "DI Framework",
    "Constructor Injection",
    "Singleton Pattern",
    "Multiple Scopes",
    "Scopes",
    "Dependency Resolution",
    "Clean Architecture",
    "Solid",
    "Dependency Injection Framework",
    "Service Registry",
    "Dependency Injection Library",
    "Design Patterns",
    "Software Architecture"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf build && tsc -b ./tsconfig.cjs.json ./tsconfig.esm.json ./tsconfig.types.json && cp ./config/cjs-package.json ./build/cjs/package.json",
    "lint": "eslint './src/**/*.ts' './examples/**/*.ts' './benchmarks/**/*.mjs'",
    "lint:mjs": "eslint './benchmarks/**/*.mjs'",
    "example:typecheck": "tsc --project examples/tsconfig.json",
    "example:node": "tsx examples/node-http.ts",
    "example:express": "tsx examples/express.ts",
    "example:fastify": "tsx examples/fastify.ts",
    "test": "vitest --run",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "coverage": "vitest run --coverage",
    "prepack": "yarn lint && yarn typecheck && yarn test --silent",
    "prepublishOnly": "yarn build",
    "prepare": "husky",
    "lint:staged": "eslint"
  },
  "homepage": "https://if-else.dev/docs/dependency-injection/",
  "author": {
    "name": "Nick Kryukov",
    "url": "https://if-else.dev/"
  },
  "bugs": {
    "url": "https://github.com/ZirionNeft/ioc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:ZirionNeft/ioc.git"
  },
  "license": "MIT",
  "imports": {
    "#base/*": "./src/*.js"
  },
  "exports": {
    ".": {
      "types": "./build/types/index.d.ts",
      "require": "./build/cjs/index.js",
      "import": "./build/esm/index.js",
      "default": "./build/esm/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "browserslist": [
    ">0.5%",
    "fully supports es6-module",
    "maintained node versions"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "express": "5.2.1",
    "fastify": "5.12.5",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.6.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "yarn lint:staged"
    ]
  },
  "files": [
    "build"
  ]
}
